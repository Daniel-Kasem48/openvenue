# Local development: start postgres with docker compose up -d db
DATABASE_URL=postgresql://openvenue:openvenue-local@localhost:55433/openvenue
# Replace before starting; at least 16 characters. Never commit .env.
ADMIN_PASSWORD=
PORT=3188
# Public URL used for same-origin checks behind a reverse proxy.
PUBLIC_ORIGIN=http://localhost:3188
# Docker database password. Use a strong unique value outside local development.
POSTGRES_PASSWORD=openvenue-local

# Optional: server-side Claude scene generation. Never put this key in VITE_* variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
